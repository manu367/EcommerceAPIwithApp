<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".fragement.HomeFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="90dp"
        tools:context=".fragement.HomeFragment">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <!-- Address Icon -->
            <ImageView
                android:id="@+id/homeAddressIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/home"
                android:contentDescription="Home Icon" />

            <!-- Address Texts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/addressType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/addressLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganesh Colony, Gali No 10"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/editAddressBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/edit"
                android:scaleType="fitXY"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Address" />
        </LinearLayout>

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/search_bar_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:id="@+id/search_bar_click"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_margin="10dp"
            android:gravity="center_vertical">

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search"
                android:contentDescription="Search Icon"
                app:tint="@color/gray" />

            <!-- Search Input -->
            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:hint="Search products"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- Clear Button -->
            <ImageButton
                android:id="@+id/clear_search_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:contentDescription="Clear Search"
                app:tint="@color/gray" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/bannerViewPager"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_height="200dp"/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="16dp"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:nestedScrollingEnabled="false"
            android:focusable="false"
            android:scrollbars="none"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:nestedScrollingEnabled="false"
            android:focusable="false"
            android:id="@+id/categoryShow"
            />




    </LinearLayout>


</androidx.core.widget.NestedScrollView>